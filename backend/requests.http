@apiBaseUrl = http://localhost:8080
@idempotencyKey = {{$uuid}}

### Login as a test user
POST {{apiBaseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "alex",
  "password": "UH-rj6Hxnzs67XMnvRmHH-UNJEl!"
}

> {%
if (response.status !== 200) {
  client.log("login failed with HTTP " + response.status);
} else {
  const payload = typeof response.body === "string" ? JSON.parse(response.body) : response.body;
  client.global.set("authToken", payload.token);
  client.log("authenticated as: " + payload.user.username);
}
%}

### Initiate direct upload
POST {{apiBaseUrl}}/api/uploads/initiate
Content-Type: application/json
Authorization: Bearer {{authToken}}
Idempotency-Key: {{idempotencyKey}}

{
  "fileName": "synthetic-document.pdf",
  "size": 1024
}

### Initiate chunked direct upload
POST {{apiBaseUrl}}/api/uploads/initiate-chunked
Content-Type: application/json
Authorization: Bearer {{authToken}}
Idempotency-Key: {{$uuid}}

{
  "fileName": "synthetic-document.pdf",
  "size": 9437184
}

> {%
if (response.status !== 201) {
  client.log("initiation failed with HTTP " + response.status);
} else {
  const payload = typeof response.body === "string" ? JSON.parse(response.body) : response.body;
  client.global.set("uploadId", payload.id);
  client.log("uploadId: " + payload.id);
}
%}

### Reject unsupported file type
POST {{apiBaseUrl}}/api/uploads/initiate
Content-Type: application/json
Authorization: Bearer {{authToken}}
Idempotency-Key: {{idempotencyKey}}

{
  "fileName": "synthetic-document.exe",
  "size": 1024
}

### Get upload status
GET {{apiBaseUrl}}/api/uploads/{{uploadId}}
Authorization: Bearer {{authToken}}

### Complete upload
POST {{apiBaseUrl}}/api/uploads/{{uploadId}}/complete
Authorization: Bearer {{authToken}}
